{
  "name": "to-wordpress",
  "version": "0.1.2",
  "description": "Migrate any codebase (Jekyll, Hugo, Ghost, Eleventy, plain HTML, ...) to WordPress. Driven by GitHub Copilot CLI (copilot -p) in a hybrid orchestration model and rendered as an Ink TUI.",
  "type": "module",
  "bin": {
    "to-wordpress": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/prompts",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "wordpress",
    "jekyll",
    "hugo",
    "eleventy",
    "ghost",
    "gatsby",
    "next",
    "migration",
    "migrator",
    "copilot",
    "copilot-cli",
    "cli",
    "ink",
    "tui",
    "wp-env",
    "wp-cli"
  ],
  "author": "Fatih Kadir Akın <fatihkadirakin@gmail.com> (https://blog.fka.dev)",
  "license": "MIT",
  "homepage": "https://github.com/f/to-wordpress#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f/to-wordpress.git"
  },
  "bugs": {
    "url": "https://github.com/f/to-wordpress/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "gray-matter": "^4.0.3",
    "ink": "^7.0.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.2",
    "react": "^19.2.5",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
